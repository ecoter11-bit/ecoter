# Contact form email delivery (POST /api/contatti, "Richiedi informazioni").
# Development: optional. Without these two, the request is validated, logged
# and answered with success, but no email is sent.
# Production: REQUIRED. Without them the API answers 503 ("invio non
# disponibile") so a lead is never silently dropped
# (see src/lib/contact/send-contact-email.ts).
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional — recipient of the "Ottieni corso" requests (POST /api/ottieni-corso).
# Defaults to academy@eco-ter.com when unset. Delivery still needs RESEND_API_KEY:
# without it, development validates and logs, production answers 503, exactly
# like the contact form (see src/lib/order/send-order-email.ts).
ORDER_TO_EMAIL=academy@eco-ter.com

# Sender address of both emails. Required in production, on a domain verified
# in Resend. When unset it falls back to Resend's onboarding sandbox address,
# which is only for testing and does not deliver to arbitrary recipients.
CONTACT_FROM_EMAIL=

# Optional — base URL used for canonical links, Open Graph and JSON-LD when not
# deploying to the default ecoteracademy.it domain (e.g. preview deployments).
NEXT_PUBLIC_SITE_URL=
