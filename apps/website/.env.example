# Contact form email delivery — optional in development. Without these two set,
# POST /api/contatti still validates and returns success, it just logs the
# submission instead of emailing it (see src/lib/contact/send-contact-email.ts).
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional — recipient of the "Ottieni corso" requests (POST /api/ottieni-corso).
# Defaults to academy@eco-ter.com when unset. Delivery still needs RESEND_API_KEY:
# without it the request is validated and logged instead of emailed, exactly like
# the contact form (see src/lib/order/send-order-email.ts).
ORDER_TO_EMAIL=academy@eco-ter.com

# Optional — sender address shown on delivered emails. Needs a domain verified
# in Resend for production; falls back to Resend's onboarding sandbox address
# (fine for testing, not for real delivery) when unset.
CONTACT_FROM_EMAIL=

# Optional — base URL used for canonical links and JSON-LD when not deploying
# to the default ecoteracademy.it domain (e.g. preview deployments).
NEXT_PUBLIC_SITE_URL=
